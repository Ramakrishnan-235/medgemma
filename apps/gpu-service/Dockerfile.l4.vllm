# syntax=docker/dockerfile:1.7
FROM vllm/vllm-openai:v0.8.2

LABEL maintainer="MedGemma Clinical Workspace"
LABEL hardware.target="NVIDIA-L4-24GB"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/root/.cache/huggingface \
    VLLM_WORKER_MULTIPROC_METHOD=spawn \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

WORKDIR /app

# Install additional dependencies for deterministic 896x896 preprocessing & Prometheus metrics
RUN pip install --no-cache-dir \
    fastapi>=0.115.0 \
    uvicorn[standard]>=0.32.0 \
    pillow>=10.4.0 \
    numpy>=1.26.4 \
    httpx>=0.27.2 \
    prometheus-client>=0.21.0

COPY processors.py /app/processors.py
COPY vllm_server.py /app/vllm_server.py
COPY entrypoint-l4.sh /app/entrypoint-l4.sh

RUN chmod +x /app/entrypoint-l4.sh

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=120s --retries=5 \
    CMD curl -fsS http://localhost:8080/health/gpu || exit 1

ENTRYPOINT ["/app/entrypoint-l4.sh"]

