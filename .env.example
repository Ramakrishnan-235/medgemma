# Workspace & Auth
POSTGRES_USER=medgemma
POSTGRES_PASSWORD=medgemma_dev_secret
POSTGRES_DB=medgemma_workspace
DATABASE_URL=postgresql+asyncpg://medgemma:medgemma_dev_secret@postgres:5432/medgemma_workspace

# Redis (Queue & SSE Pub/Sub only — PostgreSQL is authoritative)
REDIS_URL=redis://redis:6379/0

# Private S3 / MinIO Object Storage
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_secret
S3_BUCKET_NAME=clinical-cases

# Better Auth / JWT Verification
JWKS_URL=http://web:3000/api/auth/jwks
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=medgemma-api

# MedGemma 1.5 4B Serving Strategy
# Options: local_4bit (RTX 2050 4GB) | l4_bfloat16 (24GB L4) | vllm_remote | mock_deterministic
MEDGEMMA_MODE=local_4bit
MEDGEMMA_CHECKPOINT=google/medgemma-1.5-4b-it
MEDGEMMA_PROCESSOR_VERSION=1.5.0-896px
MEDGEMMA_SERVICE_URL=http://gpu-service:8080
MEDGEMMA_MAX_CONCURRENCY=1
HF_TOKEN=hf_your_read_token_here
