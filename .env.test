# MedGemma CI/Test Environment Configuration
POSTGRES_USER=medgemma_test
POSTGRES_PASSWORD=medgemma_test_secret
POSTGRES_DB=medgemma_test_db
DATABASE_URL=postgresql+asyncpg://medgemma_test:medgemma_test_secret@localhost:5432/medgemma_test_db

# Redis
REDIS_URL=redis://localhost:6379/1

# S3 / MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=ci_test_access_key
S3_SECRET_KEY=ci_test_secret_key
S3_BUCKET_NAME=clinical-cases-test

# Auth & JWT Verification
JWKS_URL=http://localhost:3000/api/auth/jwks
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=medgemma-api
DEBUG_ALLOW_UNVERIFIED_JWT=true

# MedGemma Test Serving Strategy
MEDGEMMA_MODE=mock_deterministic
MEDGEMMA_CHECKPOINT=google/medgemma-1.5-4b-it
MEDGEMMA_PROCESSOR_VERSION=1.5.0-896px
MEDGEMMA_SERVICE_URL=http://localhost:8080
MEDGEMMA_MAX_CONCURRENCY=1
FEATURE_MODEL_LOCALIZATION_BOXES=false
